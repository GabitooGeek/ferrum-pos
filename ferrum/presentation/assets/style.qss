/* ==========================================================================
   FERRUM POS - Modern Industrial Theme
   Palette: Dark Slate (#0f172a, #1e293b), Border (#334155), Emerald (#10b981)
   ========================================================================== */

QMainWindow {
    background-color: #0b0f19;
}

QWidget {
    color: #f1f5f9;
    font-family: 'Segoe UI', 'Ubuntu', 'Helvetica Neue', sans-serif;
    font-size: 13px;
}

/* Sidebar lateral */
QFrame#sidebar {
    background-color: #0f172a;
    border-right: 1px solid #1e293b;
}

QLabel#brand_title {
    font-size: 16px;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: 0.5px;
}

QLabel#brand_subtitle {
    font-size: 11px;
    color: #64748b;
    font-weight: 500;
    text-transform: uppercase;
}

/* Botones de navegación */
QPushButton.nav_button {
    background-color: transparent;
    color: #94a3b8;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
}

QPushButton.nav_button:hover {
    background-color: #1e293b;
    color: #f8fafc;
}

QPushButton.nav_button:checked {
    background-color: #1e293b;
    color: #38bdf8;
    border-left: 3px solid #38bdf8;
}

/* Tarjetas de Métricas (KPI Cards) */
QFrame.kpi_card {
    background-color: #131d31;
    border: 1px solid #1e293b;
    border-radius: 10px;
    padding: 16px;
}

QLabel.kpi_title {
    font-size: 11px;
    color: #94a3b8;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLabel.kpi_value {
    font-size: 22px;
    font-weight: 700;
    color: #f8fafc;
}

/* Tablas Modernas */
QTableWidget {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 10px;
    gridline-color: #1e293b;
    outline: none;
    selection-background-color: #1e293b;
    selection-color: #38bdf8;
}

QTableWidget::item {
    padding: 10px;
    border-bottom: 1px solid #1e293b;
}

QHeaderView::section {
    background-color: #131d31;
    color: #94a3b8;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 12px 10px;
    border: none;
    border-bottom: 2px solid #1e293b;
}

/* Botón Primario */
QPushButton#btn_primary {
    background-color: #0284c7;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 9px 18px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton#btn_primary:hover {
    background-color: #0369a1;
}

QPushButton#btn_primary:pressed {
    background-color: #075985;
}

/* Barra de estado inferior */
QFrame#status_bar {
    background-color: #0f172a;
    border-top: 1px solid #1e293b;
    padding: 4px 12px;
}

QLabel.status_text {
    font-size: 11px;
    color: #64748b;
    font-family: monospace;
}
